{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toaster API Collection Response",
  "type": "object",
  "required": [
    "meta",
    "count",
    "items"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "version",
        "endpoint",
        "updated_at"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "count": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "category",
          "content",
          "tags",
          "language",
          "safe"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language": {
            "type": "string"
          },
          "safe": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
